# Copy to .env.local and fill in from Supabase → Project Settings → API.
# .env.local is git-ignored and must never be committed.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon"/"publishable" key. Safe in the browser: row level security governs
# what it can do. Never put the service role key here — it bypasses RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
